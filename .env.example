# 复制为仓库根目录 .env 后按本机修改。
# docker compose 会自动读取 .env 做变量插值（不会把本文件内容打进镜像）。
#
# MINIO_PUBLIC_ENDPOINT：签给浏览器的 MinIO 地址（宿主机可访问的 IP/域名:端口）
#   本机开发：localhost:9000
#   远程访问：<公网IP>:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=edu_minio_user
MINIO_SECRET_KEY=edu_minio_pass

# 向量嵌入（可选）。留空则关闭向量去重/跨学科发现，退化为按名称精确匹配。
# 百炼兼容模式示例：
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_DIM=1024
EMBEDDING_MODEL=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

# 注册默认关闭；教师由管理员开户
ENABLE_REGIST=false

# 超级管理员（首次启动创建，之后改这里的密码不会覆盖已有超管）
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_EMAIL=admin@local
SUPER_ADMIN_REAL_NAME=超级管理员

# Celery 每个 worker 进程数（快/慢通道各自独立，默认 2）
# CELERY_WORKER_CONCURRENCY=2
