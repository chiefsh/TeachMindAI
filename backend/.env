DATABASE_URL=mysql+aiomysql://edu_user:edu_pass@localhost:3306/edu_platform
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_URL=amqp://edu_user:edu_pass@localhost:5672/
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=edu_minio_user
MINIO_SECRET_KEY=edu_minio_pass
SECRET_KEY=edu-platform-super-secret-key-2024
ENCRYPTION_KEY=edu-platform-32-byte-encrypt-key
ENVIRONMENT=development

# ── 知识图谱（Neo4j 图库 + Qdrant 向量库）──
KG_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=edu_neo4j_pass
NEO4J_DATABASE=neo4j
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
KG_COLLECTION=knowledge_points
KG_DEDUP_THRESHOLD=0.88
# 向量嵌入：留空则关闭向量去重/跨学科发现，退化为按名称精确匹配。
# 需启用时填入 LiteLLM 可识别的嵌入模型名与端点，例如：
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_BASE=https://your-llm-gateway/v1
# EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

